  "main": "nixpkgs.js",
  "scripts": {
    "test": "vitest run --exclude '**/*.live.test.js'",
    "test:watch": "vitest --exclude '**/*.live.test.js'",
    "test:coverage": "vitest run --coverage --exclude '**/*.live.test.js'",
    "test:live": "LIVE_TEST_MODE=all vitest run nixpkgs.live.test.js",
    "test:live:open": "LIVE_TEST_MODE=open vitest run nixpkgs.live.test.js",
    "test:live:merged": "LIVE_TEST_MODE=merged vitest run nixpkgs.live.test.js"
  },
